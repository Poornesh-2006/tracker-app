# Supabase (Dashboard > Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Local AI (optional). On a phone, "localhost" is the phone itself: use your
# computer's LAN IP running Ollama, e.g. http://192.168.1.20:11434/api/generate
# EXPO_PUBLIC_GEMMA_API_URL=http://localhost:11434/api/generate
# EXPO_PUBLIC_GEMMA_MODEL=gemma:7b
